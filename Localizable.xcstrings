    "Confidentialité de l'application" : {

    },
    "Consolidations" : {

    },
    "Contenu" : {

    },
    "Dans le menu %@ vous avez la possibilité d'effectuer une sauvegarde %@ de votre base de mots sous forme d'un fichier txt, pour pouvoir la recharger %@ sur un autre appareil ou bien sur le même appareil, après ré-installation de l'application.\n" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dans le menu %1$@ vous avez la possibilité d'effectuer une sauvegarde %2$@ de votre base de mots sous forme d'un fichier txt, pour pouvoir la recharger %3$@ sur un autre appareil ou bien sur le même appareil, après ré-installation de l'application.\n"
          }
        }
      }
