    "A J O U T E R" : {

    },
    "Accéder à l'aide détaillée par l'icône %@" : {

    },
    "Accéder à l'aide, aux utilitaires et aux paramètres." : {

    },
    "Accéder aux listes de mots à réactiver pour consolidation, ou bien importés d'autres bases" : {

